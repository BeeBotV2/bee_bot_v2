<!--
  bt_navigator 행동 트리 — NavigateThroughPoses (2026-11-18 재설계). navigate_to_pose.xml과 같은 구조 + 지난 경유점 지우기(RemovePassedGoals 0.40 m).
  ① 재계획: 2 Hz로 남은 경로를 전역 costmap에 대 보고(ValidatePath), 막혔거나 목표가 바뀌었을 때만 새로 계획한다.
     (경로를 매번 새로 내면 Lattice 경로가 조금씩 흔들려 추종이 출렁임 — 막힌 경우엔 0.5 s 안에 돌아갈 길을 낸다)
  ② 복구에서 제자리 회전(Spin)을 뺐다 — 몸이 뒤로 0.245 m 길어 벽 옆에서 돌면 꼬리가 벽을 친다 (11-18 nav_bench:
     장애물 앞에서 멈춘 뒤 Spin이 1 rad 돈 뒤에야 충돌을 알아채 벽에 닿음). 복구 = [1.5 s 기다림(움직이는 장애물이 비키길 —
     costmap은 안 비움: 비우면 아직 있는 장애물을 잊고 다시 경로를 그 위로 냄)] → [비우고 0.10 m 후진, 충돌 검사 켬] → [2 s 기다림]. 그래도 안 되면 ABORTED → skill_navigate·mission이 다른 면으로.
  ⑤ 계획 실패 복구는 205(출발 칸 막힘)·206(목표 칸 막힘)도 포함 — 기본 WouldAPlannerRecoveryHelp는 200·207·208만이라, 카메라 유령 점으로
     출발 칸이 막히면 costmap을 안 비우고 바로 실패했고 다음 목표도 전부 205로 끝났음 (nav_bench 11-18).
  ⑥ 전역 costmap은 통째로 비우지 않는다 (11-20 실기 bag nav_1120_141156) — 장애물은 안 비킨다고 본다. 208(길 없음)에 전체를 비우면
     등 뒤라 다시 못 본 장애물을 잊고 짧은 길로 되돌아가, 다시 보면 긴 길 → 비움 → 짧은 길을 2.5 s마다 반복하며 120 s 제자리에서 13바퀴 돎.
     이제 208은 비우지 않고 바로 실패(→ mission이 다른 면으로), 205·206(유령 점으로 출발·목표 칸 막힘)만 로봇 둘레 0.6 m의 카메라 층만 비움.
     우회로가 있으면 ValidatePath가 통과하는 한 재계획이 없어 그 길로 끝까지 간다.
  ③ goal checker = general_goal_checker (통과 지점이라 넓게).
  ④ BT ID를 Nav2 기본 파일과 다르게 — 같은 ID면 bt_navigator가 "conflicting BT XML"로 하나를 건너뜀.
  ros_system.launch.py가 bt_navigator의 default_nav_through_poses_bt_xml 로 넘긴다.
-->
<root BTCPP_format="4" main_tree_to_execute="BeeNavigateThroughPoses">
  <BehaviorTree ID="BeeNavigateThroughPoses">
    <RecoveryNode number_of_retries="3" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ProgressCheckerSelector selected_progress_checker="{selected_progress_checker}" default_progress_checker="progress_checker" topic_name="progress_checker_selector"/>
        <GoalCheckerSelector selected_goal_checker="{selected_goal_checker}" default_goal_checker="general_goal_checker" topic_name="goal_checker_selector"/>
        <PathHandlerSelector selected_path_handler="{selected_path_handler}" default_path_handler="PathHandler" topic_name="path_handler_selector"/>
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <!-- 11-20 (사용자): 카메라 장애물 흔적 정리 — 5 s마다 로봇 둘레 사각형 밖의 카메라 층만 비움 (저장 지도 static_layer는 그대로).
             장애물 칸은 레이가 다시 지나가야만 지워져, 옆·뒤·벽 뒤로 번진 칸이 계속 남았음. reset_distance = 남길 사각형 한 변
             (local 2.0 m = ±1.0 m — 앞 1 m 밖은 다음 프레임(10 Hz)에 다시 찍힘). 실패해도 주행은 계속 (ForceSuccess)
             global은 안 비움 (⑥과 같은 이유, 11-20 시뮬): ±1.5 m 밖을 비우면 우회하며 멀어진 막힌 문을 잊고 짧은 길로 되돌아가 왕복함 -->
        <RateController hz="0.2">
          <ForceSuccess>
            <Sequence name="ClearStaleObstacles">
              <ClearCostmapExceptRegion name="ClearLocalExceptRobot" service_name="local_costmap/clear_except_local_costmap" reset_distance="2.0" plugins="voxel_layer"/>
            </Sequence>
          </ForceSuccess>
        </RateController>
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePath">
            <Fallback name="FallbackComputePath">
              <ReactiveSequence name="CheckIfNewPathNeeded">
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsGoalNearby path="{path}" proximity_threshold="10.0" max_robot_pose_search_dist="1.5"/>
                <TruncatePathLocal input_path="{path}" output_path="{remaining_path}" distance_forward="-1" distance_backward="0.0" />
                <ValidatePath path="{remaining_path}"/>
              </ReactiveSequence>
              <ReactiveSequence>
                <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.40" input_waypoint_statuses="{waypoint_statuses}" output_waypoint_statuses="{waypoint_statuses}"/>
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
              </ReactiveSequence>
            </Fallback>
            <Sequence>
              <AreErrorCodesPresent error_code="{compute_path_error_code}" error_codes_to_check="205;206"/>
              <ClearCostmapAroundRobot name="ClearGlobalAroundRobot-Context" service_name="global_costmap/clear_around_global_costmap" reset_distance="0.6" plugins="obstacle_layer"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}" error_msg="{follow_path_error_msg}" goal_checker_id="{selected_goal_checker}" progress_checker_id="{selected_progress_checker}" path_handler_id="{selected_path_handler}" tracking_feedback="{tracking_feedback}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <AreErrorCodesPresent error_code="{compute_path_error_code}" error_codes_to_check="205;206"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Wait wait_duration="1.5" error_code_id="{wait_error_code}" error_msg="{wait_error_msg}"/>
            <Sequence name="ClearAndBackUp">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearCostmapAroundRobot name="ClearGlobalAroundRobot-Subtree" service_name="global_costmap/clear_around_global_costmap" reset_distance="0.6" plugins="obstacle_layer"/>
              <BackUp backup_dist="0.10" backup_speed="0.05" disable_collision_checks="false" error_code_id="{backup_error_code}" error_msg="{backup_error_msg}"/>
            </Sequence>
            <Wait wait_duration="2.0" error_code_id="{wait_error_code}" error_msg="{wait_error_msg}"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
